[user]
  email = c@cooperrunyan.com
  name = cooperrunyan
  signingkey = ~/.ssh/id_ed25519.pub

[include]
  path = custom.gitconfig

[author]
  name = cooperrunyan
  email = c@cooperrunyan.com

[github]
  user = cooperrunyan

[init]
  defaultBranch = main

[core]
  filemode = false

[pull]
  rebase = true

[fetch]
  prune = true

[core]
  trustctime = false
  precomposeunicode = false
  untrackedCache = true
  fsmonitor = true
  autocrlf = input


[url "git@github.com:"]
  insteadOf = "g:"

[url "git@github.com:cooperrunyan/"]
  insteadOf = "c:"

[alias]
  sm = submodule
  ch = checkout
  b = branch
  ls = ls-files
  c = commit -m
  aa = add -A
  wdiff = diff --word-diff
  ignore = rm --cached -r
  amend = commit --all --amend --no-edit
  lg = log --graph --decorate --all --pretty=\"%C(auto)%h %C(brightblack)%ad%C(reset) %C(auto) %>|(-1) % d%C(reset)%n%C(bold blue)%an%C(nobold) %C(dim black)%ae%C(reset)%n%n%w(72,4,4)%s%n%n\"
  who = shortlog -se

[gpg]
  format = ssh

[tag]
  gpgsign = true

[commit]
  gpgsign = true
  status = false

[log]
  abbrevCommit = true
  decorate = short
  follow = true
  initialDecorationSet = all
  date = relative

[push]
  autoSetupRemote = true
  default = current

[rerere]
  enabled = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[status]
  short = true
